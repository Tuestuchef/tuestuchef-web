{
  "name": "tuestuchef",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start --workdir src/common/lib",
    "db:stop": "supabase stop --workdir src/common/lib",
    "db:reset": "supabase db reset --workdir src/common/lib",
    "db:migration": "supabase migration new --workdir src/common/lib",
    "db:push": "supabase db push --workdir src/common/lib",
    "db:link:demo": "supabase link --project-ref zfwohweuprtllcozbqdk --workdir src/common/lib",
    "db:link:prod": "supabase link --project-ref qldqiemwxtaqkvmskxmr --workdir src/common/lib",
    "db:linked": "node -e \"const r=require('fs').readFileSync('src/common/lib/supabase/.temp/project-ref','utf8').trim();console.log(r==='zfwohweuprtllcozbqdk'?'DEMO (staging)':r==='qldqiemwxtaqkvmskxmr'?'PRODUCCIÓN':r)\"",
    "db:types": "supabase gen types typescript --local --workdir src/common/lib > src/common/lib/db/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked --workdir src/common/lib > src/common/lib/db/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "vitest run src/common/lib/db/tests",
    "email:auth": "vitest run -u src/modules/auth/components/emails",
    "create-first-owner": "node --env-file=.env.local scripts/create-first-owner.mjs",
    "create-first-owner:demo": "node --env-file=.env.staging.local scripts/create-first-owner.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
