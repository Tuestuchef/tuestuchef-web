# Copia este archivo a .env.local (local) o carga las variables en Vercel (producción).
# Nunca subas .env.local al repositorio.
#
# Las variables NEXT_PUBLIC_ llegan al navegador. Todas las demás son solo del servidor.

# ------------------------------------------------------------
# App
# ------------------------------------------------------------

# URL pública del panel, sin barra final. Se usa en metadata y en los enlaces de los correos.
# Local: http://localhost:3000 · Producción: https://admin.tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

# URL del proyecto. Local: la imprime `npm run db:start` (API URL).
# Producción: Supabase → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publicable (sb_publishable_...). Segura en el navegador: todo pasa por RLS.
# Local: la imprime `npm run db:start`. Producción: Project Settings → API Keys → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). SOLO servidor: salta RLS. OBLIGATORIA para iniciar sesión:
# antes de enviar el código se comprueba que el correo pertenece a un usuario activo (así un
# desactivado no puede pedir código). También la usan las invitaciones y el script del primer
# owner. Local: la imprime `npm run db:start`. Producción: Project Settings → API Keys →
# Secret keys → crear una ("tuestuchef-server").
SUPABASE_SECRET_KEY=

# Protege el cron de tasas (/api/cron/exchange-rates). Vercel Cron lo envía solo si existe
# esta variable en el proyecto. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel → Project → Settings → Environment Variables → CRON_SECRET (Production).
CRON_SECRET=

# ------------------------------------------------------------
# Cloudflare R2 (comprobantes y fotos). Solo servidor.
# Si faltan R2_ACCOUNT_ID, R2_ACCESS_KEY_ID o R2_SECRET_ACCESS_KEY, los comprobantes quedan
# deshabilitados con un aviso y el resto de la app funciona igual.
# ------------------------------------------------------------

# Account ID de Cloudflare (32 caracteres hex). Cloudflare → R2 → Overview (columna derecha,
# "Account ID"), o en la URL del panel: dash.cloudflare.com/<ACCOUNT_ID>/r2
R2_ACCOUNT_ID=

# Credenciales S3 de un token de API de R2 con permiso "Object Read & Write" limitado a los
# buckets tuestuchef-public y tuestuchef-private. Se muestran UNA sola vez al crear el token:
# Cloudflare → R2 → Manage R2 API Tokens → Create API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombres de los buckets. Opcionales: por defecto tuestuchef-public y tuestuchef-private.
R2_PUBLIC_BUCKET=tuestuchef-public
R2_PRIVATE_BUCKET=tuestuchef-private

# Dominio propio del bucket público (fotos de productos, con caché de Cloudflare), sin barra
# final. Cloudflare → R2 → tuestuchef-public → Settings → Custom Domains. Opcional por ahora:
# los comprobantes no lo usan.
R2_PUBLIC_URL=

# ------------------------------------------------------------
# Resend: SMTP de Supabase Auth (códigos de acceso e invitaciones)
# La app no las lee: son la configuración SMTP de Supabase. En la nube se copian en
# Supabase → Authentication → Emails → SMTP Settings (ver docs/puesta-en-marcha.md).
# Localmente las usa src/common/lib/supabase/config.toml si activas [auth.email.smtp]
# (por defecto los correos locales llegan a Mailpit: http://127.0.0.1:54324).
#   Host: smtp.resend.com · Puerto: 465 · Usuario: resend · Contraseña: RESEND_API_KEY
# ------------------------------------------------------------

# API key de Resend con permiso "Sending access" (Resend → API Keys → Create API Key).
# Es la contraseña del SMTP.
RESEND_API_KEY=

# Remitente de los correos de acceso. Debe ser de un dominio verificado en Resend
# (Resend → Domains → Add Domain → registros DNS en Cloudflare). Ej.: acceso@tuestuchef.com
AUTH_EMAIL_FROM=

# Nombre que ve la persona en su bandeja de entrada.
AUTH_EMAIL_SENDER_NAME=Tuestuchef
